//@version=6
strategy("ASR BTC Strategy v17 + Structure Trend Filter",
         overlay=true,
         precision=2,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=33,
         commission_type=strategy.commission.percent,
         commission_value=0.036,
         slippage=3,
         pyramiding=3,
         calc_on_every_tick=false,
         max_labels_count=500,
         margin_long=0,
         margin_short=0)

string GRP_TF = "Timeframe Adaptation"
baseTFMinutes = input.int(60, "Base Timeframe (min)", group=GRP_TF)
currentTF = timeframe.in_seconds(timeframe.period) / 60.0
tfMultiplier = baseTFMinutes / currentTF

string GRP_IND = "ASR Indicator"
hlLength_input = input.int(75, "HL Length (base)", group=GRP_IND, minval=10, maxval=200)
atrLength_input = input.int(20, "ATR Length (base)", group=GRP_IND, minval=5, maxval=100)
vovLength_input = input.int(100, "VoV Length (base)", group=GRP_IND, minval=20, maxval=300)
smoothFactor_input = input.int(12, "Smooth Factor (base)", group=GRP_IND, minval=2, maxval=50)
baseWidthPct = input.float(8.0, "Base Width %", group=GRP_IND, minval=1.0, maxval=20.0, step=0.5)
adjustFactor = input.float(0.5, "Adjust Factor", group=GRP_IND, minval=0.1, maxval=2.0, step=0.1)

hlLength = int(math.round(math.max(1, hlLength_input * tfMultiplier)))
atrLength = int(math.round(math.max(1, atrLength_input * tfMultiplier)))
vovLength = int(math.round(math.max(1, vovLength_input * tfMultiplier)))
smoothFactor = int(math.round(math.max(1, smoothFactor_input * tfMultiplier)))

string GRP_STR = "Strategy Parameters"
zoneChannelPct = input.float(8.0, "Zone % of Channel", group=GRP_STR, minval=0.5, maxval=30.0, step=0.5) / 100.0
stopMult = input.float(2.5, "Stop Multiplier", group=GRP_STR, minval=0.5, maxval=5.0, step=0.1)
beBuffer = input.float(0.3, "BE Buffer %", group=GRP_STR, minval=0.0, maxval=1.0, step=0.1) / 100.0
mfeProtectZoneMult = input.float(2.5, "MFE Protect Zone Mult", group=GRP_STR, minval=1.0, maxval=10.0, step=0.25)
level0MfeProtectZoneMult = input.float(3.0, "Level0 MFE Protect Zone Mult", group=GRP_STR, minval=1.0, maxval=10.0, step=0.25)
mfeProtectMinBars = input.int(32, "MFE Protect Min Bars", group=GRP_STR, minval=0, maxval=100)
timeStopBars_in = input.int(56, "Time Stop Bars (base)", group=GRP_STR, minval=4, maxval=100)
timeStopBars = int(math.round(math.max(1, timeStopBars_in * tfMultiplier)))
outsideStopBars = input.int(3, "Outside Channel Stop Bars", group=GRP_STR, minval=1, maxval=20)
entrySrLookback = input.int(64, "Trend Entry S/R Lookback", group=GRP_STR, minval=5, maxval=100)
entryAtrPullbackMult = input.float(0.35, "Trend Entry ATR Pullback Mult", group=GRP_STR, minval=0.05, maxval=2.0, step=0.05)
entryChannelPullbackMult = input.float(0.12, "Trend Entry Channel Pullback Mult", group=GRP_STR, minval=0.02, maxval=0.5, step=0.01)
entrySrBufferAtrMult = input.float(0.25, "Trend Entry S/R Buffer ATR Mult", group=GRP_STR, minval=0.05, maxval=1.0, step=0.05)
rsiPeriod = input.int(14, "RSI Period", group=GRP_STR, minval=5, maxval=30)
rsiLong = input.float(40.0, "RSI Long Threshold", group=GRP_STR, minval=20.0, maxval=60.0)
rsiShort = input.float(60.0, "RSI Short Threshold", group=GRP_STR, minval=40.0, maxval=80.0)
cooldownBars_in = input.int(3, "Cooldown Bars (base)", group=GRP_STR, minval=0, maxval=20)
cooldownBars = int(math.round(math.max(0, cooldownBars_in * tfMultiplier)))
enableShort = input.bool(true, "Enable Short", group=GRP_STR)
breakout15m = input.bool(true, "15m Breakout Flip", group=GRP_STR)
breakoutRsiHigh = input.float(78.0, "15m Breakout Long TP RSI", group=GRP_STR, minval=50.0, maxval=95.0)
breakoutRsiLow = input.float(22.0, "15m Breakout Short TP RSI", group=GRP_STR, minval=5.0, maxval=50.0)
breakoutBackBars = input.int(2, "15m Breakout Back-In Bars", group=GRP_STR, minval=1, maxval=10)
breakoutConfirmBars = input.int(2, "15m Breakout Confirm Bars", group=GRP_STR, minval=1, maxval=10)
breakoutMinHoldBars = input.int(40, "15m Breakout Min Hold Bars", group=GRP_STR, minval=1, maxval=100)
breakoutCooldownBars = input.int(48, "15m Breakout Cooldown Bars", group=GRP_STR, minval=1, maxval=200)
reverseStopLookback = input.int(30, "15m Reverse Stop Lookback", group=GRP_STR, minval=5, maxval=200)

string GRP_TREND = "Structure Trendline Filter"
structureMaLen = input.int(60, "Structure Trendline MA Length", group=GRP_TREND, minval=1)
structureTrendTF = input.timeframe("240", "Structure Trend Timeframe", group=GRP_TREND)
midStructureTrendTF = input.timeframe("60", "Mid Structure Trend Timeframe", group=GRP_TREND)
structureAtrLen = input.int(14, "Structure ATR Length", group=GRP_TREND, minval=1)
structureRevAtrMult = input.float(1.60, "Structure Reversal ATR Mult", group=GRP_TREND, minval=0.1, step=0.1)
structureRevPct = input.float(0.40, "Structure Reversal Min %", group=GRP_TREND, minval=0.0, step=0.05)
structureZoneAtrMult = input.float(0.35, "Structure Zone ATR Mult", group=GRP_TREND, minval=0.0, step=0.05)
structureZonePct = input.float(0.10, "Structure Zone %", group=GRP_TREND, minval=0.0, step=0.01)
structureRangePivotCount = input.int(2, "Structure Range Pivot Count", group=GRP_TREND, minval=1, maxval=5)
structureProtectPivotCount = input.int(2, "Structure Protect Pivot Count", group=GRP_TREND, minval=1, maxval=3)
structureSwitchConfirmCount = input.int(1, "Structure Switch Confirm Count", group=GRP_TREND, minval=1, maxval=3)
structureKeepTrendWhenInside = input.bool(true, "Keep Trend On Inside Pivots", group=GRP_TREND)

string GRP_DSP = "Display"
showBands = input.bool(true, "Show ASR Bands", group=GRP_DSP)
showTrendMA = input.bool(true, "Show Structure Trendline", group=GRP_DSP)
showStopLine = input.bool(true, "Show Stop Level", group=GRP_DSP)
showBreakoutBands = input.bool(false, "Show Breakout Bands", group=GRP_DSP)

f_adaptiveStructureTrend(
     int _atrLen,
     float _revAtrMult,
     float _revPct,
     float _zoneAtrMult,
     float _zonePct,
     int _rangePivotCount,
     int _protectPivotCount,
     int _switchConfirmCount,
     bool _keepTrendWhenInside
) =>
    atr = ta.atr(_atrLen)
    reversalSize = math.max(atr * _revAtrMult, close * _revPct * 0.01)
    zoneSize = math.max(atr * _zoneAtrMult, close * _zonePct * 0.01)

    var int leg = 0
    var int trend = 0
    var float candidateHigh = na
    var float candidateLow = na
    var float lastSwingHigh = na
    var float lastSwingLow = na
    var float prevSwingHigh1 = na
    var float prevSwingHigh2 = na
    var float prevSwingLow1 = na
    var float prevSwingLow2 = na
    var int neutralPivotCounter = 0
    var int bullBreakCounter = 0
    var int bearBreakCounter = 0

    if na(candidateHigh)
        candidateHigh := high
    if na(candidateLow)
        candidateLow := low

    if leg == 0
        candidateHigh := math.max(candidateHigh, high)
        candidateLow := math.min(candidateLow, low)

        upMoveFromLow = high - candidateLow
        downMoveFromHigh = candidateHigh - low

        if upMoveFromLow >= reversalSize and upMoveFromLow >= downMoveFromHigh
            if not na(lastSwingLow)
                isHL = candidateLow > lastSwingLow + zoneSize
                isLL = candidateLow < lastSwingLow - zoneSize

                if isHL
                    trend := 1
                    neutralPivotCounter := 0
                    bearBreakCounter := 0
                else if isLL
                    trend := -1
                    neutralPivotCounter := 0
                    bullBreakCounter := 0
                else
                    neutralPivotCounter += 1

            if not na(lastSwingLow)
                prevSwingLow2 := prevSwingLow1
                prevSwingLow1 := lastSwingLow

            lastSwingLow := candidateLow
            leg := 1
            candidateHigh := high

        else if downMoveFromHigh >= reversalSize
            if not na(lastSwingHigh)
                isHH = candidateHigh > lastSwingHigh + zoneSize
                isLH = candidateHigh < lastSwingHigh - zoneSize

                if isHH
                    trend := 1
                    neutralPivotCounter := 0
                    bearBreakCounter := 0
                else if isLH
                    trend := -1
                    neutralPivotCounter := 0
                    bullBreakCounter := 0
                else
                    neutralPivotCounter += 1

            if not na(lastSwingHigh)
                prevSwingHigh2 := prevSwingHigh1
                prevSwingHigh1 := lastSwingHigh

            lastSwingHigh := candidateHigh
            leg := -1
            candidateLow := low

    else if leg == 1
        candidateHigh := math.max(candidateHigh, high)

        if candidateHigh - low >= reversalSize
            if not na(lastSwingHigh)
                protectedHigh = lastSwingHigh

                if _protectPivotCount >= 2 and not na(prevSwingHigh1)
                    protectedHigh := math.max(protectedHigh, prevSwingHigh1)

                if _protectPivotCount >= 3 and not na(prevSwingHigh2)
                    protectedHigh := math.max(protectedHigh, prevSwingHigh2)

                isHH = candidateHigh > lastSwingHigh + zoneSize
                isLH = candidateHigh < lastSwingHigh - zoneSize
                breaksProtectedHigh = candidateHigh > protectedHigh + zoneSize

                if trend == -1
                    if breaksProtectedHigh
                        bullBreakCounter += 1
                        bearBreakCounter := 0

                        if bullBreakCounter >= _switchConfirmCount
                            trend := 1
                            bullBreakCounter := 0
                            neutralPivotCounter := 0

                    else if isLH
                        trend := -1
                        bullBreakCounter := 0
                        neutralPivotCounter := 0

                    else
                        if _keepTrendWhenInside
                            neutralPivotCounter := 0
                        else
                            neutralPivotCounter += 1

                else if trend == 1
                    if isHH
                        trend := 1
                        bearBreakCounter := 0
                        neutralPivotCounter := 0
                    else
                        if _keepTrendWhenInside
                            neutralPivotCounter := 0
                        else
                            neutralPivotCounter += 1

                else
                    if isHH
                        trend := 1
                        neutralPivotCounter := 0
                    else if isLH
                        trend := -1
                        neutralPivotCounter := 0
                    else
                        neutralPivotCounter += 1

            if not na(lastSwingHigh)
                prevSwingHigh2 := prevSwingHigh1
                prevSwingHigh1 := lastSwingHigh

            lastSwingHigh := candidateHigh
            leg := -1
            candidateLow := low

    else if leg == -1
        candidateLow := math.min(candidateLow, low)

        if high - candidateLow >= reversalSize
            if not na(lastSwingLow)
                protectedLow = lastSwingLow

                if _protectPivotCount >= 2 and not na(prevSwingLow1)
                    protectedLow := math.min(protectedLow, prevSwingLow1)

                if _protectPivotCount >= 3 and not na(prevSwingLow2)
                    protectedLow := math.min(protectedLow, prevSwingLow2)

                isHL = candidateLow > lastSwingLow + zoneSize
                isLL = candidateLow < lastSwingLow - zoneSize
                breaksProtectedLow = candidateLow < protectedLow - zoneSize

                if trend == 1
                    if breaksProtectedLow
                        bearBreakCounter += 1
                        bullBreakCounter := 0

                        if bearBreakCounter >= _switchConfirmCount
                            trend := -1
                            bearBreakCounter := 0
                            neutralPivotCounter := 0

                    else if isHL
                        trend := 1
                        bearBreakCounter := 0
                        neutralPivotCounter := 0

                    else
                        if _keepTrendWhenInside
                            neutralPivotCounter := 0
                        else
                            neutralPivotCounter += 1

                else if trend == -1
                    if isLL
                        trend := -1
                        bullBreakCounter := 0
                        neutralPivotCounter := 0
                    else
                        if _keepTrendWhenInside
                            neutralPivotCounter := 0
                        else
                            neutralPivotCounter += 1

                else
                    if isHL
                        trend := 1
                        neutralPivotCounter := 0
                    else if isLL
                        trend := -1
                        neutralPivotCounter := 0
                    else
                        neutralPivotCounter += 1

            if not na(lastSwingLow)
                prevSwingLow2 := prevSwingLow1
                prevSwingLow1 := lastSwingLow

            lastSwingLow := candidateLow
            leg := 1
            candidateHigh := high

    if not _keepTrendWhenInside and neutralPivotCounter >= _rangePivotCount
        trend := 0
        bullBreakCounter := 0
        bearBreakCounter := 0

    trend

float tpOffsetMultiplier = 0.5
float deepEntryOvershootPct = 0.35
bool reverseBreakevenOnChannel = true
bool deepEntryReclaim = true
bool mfeZoneBreakeven = true
bool level0MfeZoneBreakeven = true
bool l1KnifeHalfSize = true
bool noProgressTimeStop = true
int reverseLockBars = 136
float allocPct1Base = 20.0
float allocPct2Base = 40.0
float allocPct3Base = 40.0

midLine = ta.sma((high + low) / 2.0, hlLength)
atr_ = ta.atr(atrLength)
tr_ = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
rocVol = ta.stdev(math.abs(ta.roc(close, 1)), 20) / close * 10000.0
compVol = tr_ * 0.4 + atr_ * 0.4 + rocVol * 0.2
vovDenom = ta.sma(compVol, vovLength)
vov = vovDenom > 0 ? ta.stdev(compVol, vovLength) / vovDenom : 0.0
vovSafe = na(vov) or vov > 10.0 ? 0.0 : vov
dynamicOffset = (midLine * baseWidthPct / 100.0 / 2.0) * (1.0 + vovSafe * adjustFactor)
smoothRes = ta.ema(midLine + dynamicOffset, smoothFactor)
smoothSup = ta.ema(midLine - dynamicOffset, smoothFactor)
smoothMid = ta.ema(midLine, smoothFactor)
midHigh = (smoothMid + smoothRes) / 2.0
midLow = (smoothMid + smoothSup) / 2.0
superbuy = smoothMid + dynamicOffset * 1.618
supersell = smoothMid - dynamicOffset * 1.618
uperLine = smoothRes + dynamicOffset * 0.25
downerLine = smoothSup - dynamicOffset * 0.25
channelWidth = math.max(math.max(math.abs(smoothRes - smoothSup), syminfo.mintick * 2.0), syminfo.mintick * 2.0)
zoneOffset = math.max(syminfo.mintick, channelWidth * zoneChannelPct)
tpZoneOffset = math.max(syminfo.mintick, zoneOffset * tpOffsetMultiplier)
mfeProtectTrigger = zoneOffset * mfeProtectZoneMult
level0MfeProtectTrigger = zoneOffset * level0MfeProtectZoneMult
maxDeepEntryOvershoot = channelWidth * deepEntryOvershootPct
recentEntrySupport = ta.lowest(low, entrySrLookback)[1]
recentEntryResistance = ta.highest(high, entrySrLookback)[1]
entryPullbackOffset = math.max(zoneOffset, math.max(atr_ * entryAtrPullbackMult, channelWidth * entryChannelPullbackMult))
entrySrBuffer = math.max(zoneOffset, atr_ * entrySrBufferAtrMult)
longTrendEntryLevel = na(recentEntrySupport) ? smoothMid - entryPullbackOffset : math.max(smoothSup, math.min(smoothMid - entryPullbackOffset, recentEntrySupport + entrySrBuffer))
shortTrendEntryLevel = na(recentEntryResistance) ? smoothMid + entryPullbackOffset : math.min(smoothRes, math.max(smoothMid + entryPullbackOffset, recentEntryResistance - entrySrBuffer))
majorStructureTrend = request.security(
     syminfo.tickerid,
     structureTrendTF,
     f_adaptiveStructureTrend(
         structureAtrLen,
         structureRevAtrMult,
         structureRevPct,
         structureZoneAtrMult,
         structureZonePct,
         structureRangePivotCount,
         structureProtectPivotCount,
         structureSwitchConfirmCount,
         structureKeepTrendWhenInside
     )[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

midStructureTrend = request.security(
     syminfo.tickerid,
     midStructureTrendTF,
     f_adaptiveStructureTrend(
         structureAtrLen,
         structureRevAtrMult,
         structureRevPct,
         structureZoneAtrMult,
         structureZonePct,
         structureRangePivotCount,
         structureProtectPivotCount,
         structureSwitchConfirmCount,
         structureKeepTrendWhenInside
     )[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

isMidWarning = majorStructureTrend != 0 and midStructureTrend != 0 and midStructureTrend != majorStructureTrend
structureTrend = isMidWarning ? 0 : majorStructureTrend
structureTrendLine = ta.sma(close, structureMaLen)
structureTrendColor =
     structureTrend == 1 ? color.green :
     structureTrend == -1 ? color.red :
     color.blue
allowLongByStructure = structureTrend == 1 or structureTrend == 0
allowShortByStructure = structureTrend == -1 or structureTrend == 0
rsiVal = ta.rsi(close, rsiPeriod)
reverseLongStopRef = ta.highest(high, reverseStopLookback)[1]
reverseShortStopRef = ta.lowest(low, reverseStopLookback)[1]
reverseStopBuffer = math.max(syminfo.mintick, atr_ * 0.1)
reverseShortStopPxRef = na(reverseLongStopRef) ? na : math.max(high, reverseLongStopRef) + reverseStopBuffer
reverseLongStopPxRef = na(reverseShortStopRef) ? na : math.min(low, reverseShortStopRef) - reverseStopBuffer
curOfs = math.max(dynamicOffset, 1.0)

ready = not na(smoothRes) and not na(smoothSup) and not na(smoothMid) and not na(midHigh) and not na(midLow) and not na(zoneOffset) and not na(structureTrendLine) and not na(structureTrend) and not na(rsiVal) and not na(atr_) and not na(dynamicOffset)

var int nLong = 0
var int nShort = 0
var int lastEntryBar = 0
var float entryPx1 = na
var float entryPx2 = na
var float entryPx3 = na
var int entryBar1 = 0
var int entryBar2 = 0
var int entryBar3 = 0
var bool be1 = false
var bool be2 = false
var bool be3 = false
var int trendMode = 0
var int breakoutInsideBars = 0
var int breakoutAboveBars = 0
var int breakoutBelowBars = 0
var int breakoutEntryBar = na
var int lastBreakoutBar = -10000
var float reverseStopPx = na
var float reverseTpPx = na
var int outsideLongBars = 0
var int outsideShortBars = 0

var float mfe1 = na
var float mfe2 = na
var float mfe3 = na
var float trendEntryPx = na
var int trendEntryBar = na
var float trendMfeAbs = na
var int trendDir = 0
var float reverseEntryPx = na
var int reverseEntryBar = na
var float reverseMfeAbs = na
var int reverseDir = 0

isLong = strategy.position_size > 0
isShort = strategy.position_size < 0
isFlat = strategy.position_size == 0
bullishCandle = close > open
bearishCandle = close < open
cooldownOK = bar_index - lastEntryBar >= cooldownBars
is15m = math.abs(currentTF - 15.0) < 0.1
reverseLockActive = (trendMode == 2 or trendMode == -2) and (bar_index - lastEntryBar) < reverseLockBars
reverseInChannel = close >= smoothSup and close <= smoothRes

getStop(ep, isBuy, isBE) =>
    isBE ? (isBuy ? ep * (1.0 + beBuffer) : ep * (1.0 - beBuffer)) : (isBuy ? ep - stopMult * curOfs : ep + stopMult * curOfs)

timeCheck(entBar, ep, isBuy) =>
    barsHeld = bar_index - entBar
    profitable = isBuy ? close > ep : close < ep
    shouldCut = barsHeld >= timeStopBars * 2 and not profitable
    shouldBE = barsHeld >= timeStopBars and profitable
    [shouldCut, shouldBE]

noProgressCheck(entBar, ep, isBuy, mfeAbs) =>
    barsHeld = bar_index - entBar
    profitable = isBuy ? close > ep : close < ep
    noProgressTimeStop and barsHeld >= timeStopBars and not profitable and nz(mfeAbs, 0.0) < zoneOffset

if ready
    if not na(entryPx1)
        mfe1 := isLong ? math.max(nz(mfe1, 0.0), high - entryPx1) : isShort ? math.max(nz(mfe1, 0.0), entryPx1 - low) : nz(mfe1, 0.0)
    if not na(entryPx2)
        mfe2 := isLong ? math.max(nz(mfe2, 0.0), high - entryPx2) : isShort ? math.max(nz(mfe2, 0.0), entryPx2 - low) : nz(mfe2, 0.0)
    if not na(entryPx3)
        mfe3 := isLong ? math.max(nz(mfe3, 0.0), high - entryPx3) : isShort ? math.max(nz(mfe3, 0.0), entryPx3 - low) : nz(mfe3, 0.0)

    if not na(trendEntryPx)
        trendMfeAbs := trendDir == 1 ? math.max(nz(trendMfeAbs, 0.0), high - trendEntryPx) : trendDir == -1 ? math.max(nz(trendMfeAbs, 0.0), trendEntryPx - low) : nz(trendMfeAbs, 0.0)
    if not na(reverseEntryPx)
        reverseMfeAbs := reverseDir == 1 ? math.max(nz(reverseMfeAbs, 0.0), high - reverseEntryPx) : reverseDir == -1 ? math.max(nz(reverseMfeAbs, 0.0), reverseEntryPx - low) : nz(reverseMfeAbs, 0.0)

    breakoutAboveBars := breakout15m and is15m and close > superbuy ? breakoutAboveBars + 1 : 0
    breakoutBelowBars := breakout15m and is15m and close < supersell ? breakoutBelowBars + 1 : 0
    breakoutReady = bar_index - lastBreakoutBar >= breakoutCooldownBars
    breakoutUp = breakout15m and is15m and trendMode == 0 and breakoutReady and allowLongByStructure and breakoutAboveBars >= breakoutConfirmBars
    breakoutDown = breakout15m and is15m and trendMode == 0 and breakoutReady and allowShortByStructure and breakoutBelowBars >= breakoutConfirmBars
    didBreakoutFlip = false
    didBreakoutExit = false
    didFastExit = false

    outsideLongBars := trendMode == 0 and isLong and close < downerLine ? outsideLongBars + 1 : 0
    outsideShortBars := trendMode == 0 and isShort and close > uperLine ? outsideShortBars + 1 : 0

    if reverseBreakevenOnChannel and trendMode == 2 and isLong and reverseInChannel and not na(strategy.position_avg_price)
        reverseStopPx := math.max(nz(reverseStopPx, strategy.position_avg_price), strategy.position_avg_price)
    if reverseBreakevenOnChannel and trendMode == -2 and isShort and reverseInChannel and not na(strategy.position_avg_price)
        reverseStopPx := math.min(nz(reverseStopPx, strategy.position_avg_price), strategy.position_avg_price)

    if breakoutUp and trendMode != 1
        strategy.close_all("Breakout Flip Up")
        strategy.entry("TrendLong", strategy.long, qty=strategy.equity / close)
        nLong := 0
        nShort := 0
        entryPx1 := na
        entryPx2 := na
        entryPx3 := na
        entryBar1 := 0
        entryBar2 := 0
        entryBar3 := 0
        be1 := false
        be2 := false
        be3 := false
        mfe1 := na
        mfe2 := na
        mfe3 := na
        trendMode := 1
        breakoutInsideBars := 0
        breakoutEntryBar := bar_index
        lastBreakoutBar := bar_index
        reverseStopPx := na
        reverseTpPx := na
        lastEntryBar := bar_index
        trendEntryPx := close
        trendEntryBar := bar_index
        trendMfeAbs := 0.0
        trendDir := 1
        reverseEntryPx := na
        reverseEntryBar := na
        reverseMfeAbs := na
        reverseDir := 0
        didBreakoutFlip := true

    if breakoutDown and trendMode != -1
        strategy.close_all("Breakout Flip Down")
        strategy.entry("TrendShort", strategy.short, qty=strategy.equity / close)
        nLong := 0
        nShort := 0
        entryPx1 := na
        entryPx2 := na
        entryPx3 := na
        entryBar1 := 0
        entryBar2 := 0
        entryBar3 := 0
        be1 := false
        be2 := false
        be3 := false
        mfe1 := na
        mfe2 := na
        mfe3 := na
        trendMode := -1
        breakoutInsideBars := 0
        breakoutEntryBar := bar_index
        lastBreakoutBar := bar_index
        reverseStopPx := na
        reverseTpPx := na
        lastEntryBar := bar_index
        trendEntryPx := close
        trendEntryBar := bar_index
        trendMfeAbs := 0.0
        trendDir := -1
        reverseEntryPx := na
        reverseEntryBar := na
        reverseMfeAbs := na
        reverseDir := 0
        didBreakoutFlip := true

    if not didBreakoutFlip and trendMode == 1
        breakoutHeldLongEnough = not na(breakoutEntryBar) and bar_index - breakoutEntryBar >= breakoutMinHoldBars
        breakoutInsideBars := breakoutHeldLongEnough and close <= smoothRes ? breakoutInsideBars + 1 : 0
        breakoutLongTP = isLong and rsiVal >= breakoutRsiHigh
        breakoutLongStop = breakoutInsideBars >= breakoutBackBars
        if breakoutLongTP and allowShortByStructure
            strategy.entry("RevShort", strategy.short, qty=strategy.equity / close)
            trendMode := -2
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := reverseShortStopPxRef
            reverseTpPx := smoothMid
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
            reverseEntryPx := close
            reverseEntryBar := bar_index
            reverseMfeAbs := 0.0
            reverseDir := -1
            didBreakoutExit := true
        else if breakoutLongStop
            strategy.close("TrendLong", comment="Breakout Stop")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
            didBreakoutExit := true

    if not didBreakoutFlip and trendMode == -1
        breakoutHeldLongEnough = not na(breakoutEntryBar) and bar_index - breakoutEntryBar >= breakoutMinHoldBars
        breakoutInsideBars := breakoutHeldLongEnough and close >= smoothSup ? breakoutInsideBars + 1 : 0
        breakoutShortTP = isShort and rsiVal <= breakoutRsiLow
        breakoutShortStop = breakoutInsideBars >= breakoutBackBars
        if breakoutShortTP and allowLongByStructure
            strategy.entry("RevLong", strategy.long, qty=strategy.equity / close)
            trendMode := 2
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := reverseLongStopPxRef
            reverseTpPx := smoothMid
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
            reverseEntryPx := close
            reverseEntryBar := bar_index
            reverseMfeAbs := 0.0
            reverseDir := 1
            didBreakoutExit := true
        else if breakoutShortStop
            strategy.close("TrendShort", comment="Breakout Stop")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
            didBreakoutExit := true

    if not didBreakoutFlip and not didBreakoutExit and trendMode == 2 and not na(reverseStopPx) and not reverseLockActive
        reverseTpPx := smoothMid
        strategy.exit("Exit RevLong", "RevLong", stop=reverseStopPx, limit=reverseTpPx)

    if not didBreakoutFlip and not didBreakoutExit and trendMode == -2 and not na(reverseStopPx) and not reverseLockActive
        reverseTpPx := smoothMid
        strategy.exit("Exit RevShort", "RevShort", stop=reverseStopPx, limit=reverseTpPx)

    longTP1 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx1) and close >= midHigh - tpZoneOffset
    longTP2 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx2) and close >= smoothRes - tpZoneOffset
    longTP3 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx3) and close >= smoothRes - tpZoneOffset
    shortTP1 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx1) and close <= midLow + tpZoneOffset
    shortTP2 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx2) and close <= midLow + tpZoneOffset
    shortTP3 = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx3) and close <= midLow + tpZoneOffset

    if longTP1
        strategy.close("Long1", comment="TP L1")
        entryPx1 := na
        be1 := false
        mfe1 := na
        lastEntryBar := bar_index
    if longTP2
        strategy.close("Long2", comment="TP L2")
        entryPx2 := na
        be2 := false
        mfe2 := na
        lastEntryBar := bar_index
    if longTP3
        strategy.close("Long3", comment="TP L3")
        entryPx3 := na
        be3 := false
        mfe3 := na
        lastEntryBar := bar_index
    if shortTP1
        strategy.close("Short1", comment="TP S1")
        entryPx1 := na
        be1 := false
        mfe1 := na
        lastEntryBar := bar_index
    if shortTP2
        strategy.close("Short2", comment="TP S2")
        entryPx2 := na
        be2 := false
        mfe2 := na
        lastEntryBar := bar_index
    if shortTP3
        strategy.close("Short3", comment="TP S3")
        entryPx3 := na
        be3 := false
        mfe3 := na
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx1)
        [cut1, setBE1] = timeCheck(entryBar1, entryPx1, true)
        if noProgressCheck(entryBar1, entryPx1, true, mfe1)
            strategy.close("Long1", comment="NoProgress L1")
            entryPx1 := na
            be1 := false
            mfe1 := na
            lastEntryBar := bar_index
        else if cut1
            strategy.close("Long1", comment="TimeStop L1")
            entryPx1 := na
            be1 := false
            mfe1 := na
        else if setBE1 and not be1
            be1 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx2)
        [cut2, setBE2] = timeCheck(entryBar2, entryPx2, true)
        if noProgressCheck(entryBar2, entryPx2, true, mfe2)
            strategy.close("Long2", comment="NoProgress L2")
            entryPx2 := na
            be2 := false
            mfe2 := na
            lastEntryBar := bar_index
        else if cut2
            strategy.close("Long2", comment="TimeStop L2")
            entryPx2 := na
            be2 := false
            mfe2 := na
        else if setBE2 and not be2
            be2 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and not na(entryPx3)
        [cut3, setBE3] = timeCheck(entryBar3, entryPx3, true)
        if noProgressCheck(entryBar3, entryPx3, true, mfe3)
            strategy.close("Long3", comment="NoProgress L3")
            entryPx3 := na
            be3 := false
            mfe3 := na
            lastEntryBar := bar_index
        else if cut3
            strategy.close("Long3", comment="TimeStop L3")
            entryPx3 := na
            be3 := false
            mfe3 := na
        else if setBE3 and not be3
            be3 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx1)
        [cut1s, setBE1s] = timeCheck(entryBar1, entryPx1, false)
        if noProgressCheck(entryBar1, entryPx1, false, mfe1)
            strategy.close("Short1", comment="NoProgress S1")
            entryPx1 := na
            be1 := false
            mfe1 := na
            lastEntryBar := bar_index
        else if cut1s
            strategy.close("Short1", comment="TimeStop S1")
            entryPx1 := na
            be1 := false
            mfe1 := na
        else if setBE1s and not be1
            be1 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx2)
        [cut2s, setBE2s] = timeCheck(entryBar2, entryPx2, false)
        if noProgressCheck(entryBar2, entryPx2, false, mfe2)
            strategy.close("Short2", comment="NoProgress S2")
            entryPx2 := na
            be2 := false
            mfe2 := na
            lastEntryBar := bar_index
        else if cut2s
            strategy.close("Short2", comment="TimeStop S2")
            entryPx2 := na
            be2 := false
            mfe2 := na
        else if setBE2s and not be2
            be2 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and not na(entryPx3)
        [cut3s, setBE3s] = timeCheck(entryBar3, entryPx3, false)
        if noProgressCheck(entryBar3, entryPx3, false, mfe3)
            strategy.close("Short3", comment="NoProgress S3")
            entryPx3 := na
            be3 := false
            mfe3 := na
            lastEntryBar := bar_index
        else if cut3s
            strategy.close("Short3", comment="TimeStop S3")
            entryPx3 := na
            be3 := false
            mfe3 := na
        else if setBE3s and not be3
            be3 := true

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong
        if not na(entryPx1)
            strategy.exit("Exit L1", "Long1", stop=getStop(entryPx1, true, be1))
        if not na(entryPx2)
            strategy.exit("Exit L2", "Long2", stop=getStop(entryPx2, true, be2))
        if not na(entryPx3)
            strategy.exit("Exit L3", "Long3", stop=getStop(entryPx3, true, be3))

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort
        if not na(entryPx1)
            strategy.exit("Exit S1", "Short1", stop=getStop(entryPx1, false, be1))
        if not na(entryPx2)
            strategy.exit("Exit S2", "Short2", stop=getStop(entryPx2, false, be2))
        if not na(entryPx3)
            strategy.exit("Exit S3", "Short3", stop=getStop(entryPx3, false, be3))

    if mfeZoneBreakeven and trendMode == 0 and not didBreakoutFlip and not didBreakoutExit
        if isLong and not na(entryPx1) and bar_index - entryBar1 >= mfeProtectMinBars and nz(mfe1, 0.0) >= mfeProtectTrigger and close <= entryPx1 * (1.0 + beBuffer)
            strategy.close("Long1", comment="MFEProtect L1")
            entryPx1 := na
            be1 := false
            mfe1 := na
            lastEntryBar := bar_index
        if isLong and not na(entryPx2) and bar_index - entryBar2 >= mfeProtectMinBars and nz(mfe2, 0.0) >= mfeProtectTrigger and close <= entryPx2 * (1.0 + beBuffer)
            strategy.close("Long2", comment="MFEProtect L2")
            entryPx2 := na
            be2 := false
            mfe2 := na
            lastEntryBar := bar_index
        if isLong and not na(entryPx3) and bar_index - entryBar3 >= mfeProtectMinBars and nz(mfe3, 0.0) >= mfeProtectTrigger and close <= entryPx3 * (1.0 + beBuffer)
            strategy.close("Long3", comment="MFEProtect L3")
            entryPx3 := na
            be3 := false
            mfe3 := na
            lastEntryBar := bar_index
        if isShort and not na(entryPx1) and bar_index - entryBar1 >= mfeProtectMinBars and nz(mfe1, 0.0) >= mfeProtectTrigger and close >= entryPx1 * (1.0 - beBuffer)
            strategy.close("Short1", comment="MFEProtect S1")
            entryPx1 := na
            be1 := false
            mfe1 := na
            lastEntryBar := bar_index
        if isShort and not na(entryPx2) and bar_index - entryBar2 >= mfeProtectMinBars and nz(mfe2, 0.0) >= mfeProtectTrigger and close >= entryPx2 * (1.0 - beBuffer)
            strategy.close("Short2", comment="MFEProtect S2")
            entryPx2 := na
            be2 := false
            mfe2 := na
            lastEntryBar := bar_index
        if isShort and not na(entryPx3) and bar_index - entryBar3 >= mfeProtectMinBars and nz(mfe3, 0.0) >= mfeProtectTrigger and close >= entryPx3 * (1.0 - beBuffer)
            strategy.close("Short3", comment="MFEProtect S3")
            entryPx3 := na
            be3 := false
            mfe3 := na
            lastEntryBar := bar_index

    if level0MfeZoneBreakeven and not didBreakoutFlip and not didBreakoutExit
        trendLongCanProtect = trendMode == 1 and not na(trendEntryBar) and bar_index - trendEntryBar >= breakoutMinHoldBars
        trendShortCanProtect = trendMode == -1 and not na(trendEntryBar) and bar_index - trendEntryBar >= breakoutMinHoldBars
        revLongCanProtect = trendMode == 2 and not reverseLockActive
        revShortCanProtect = trendMode == -2 and not reverseLockActive

        if trendLongCanProtect and nz(trendMfeAbs, 0.0) >= level0MfeProtectTrigger and close <= trendEntryPx * (1.0 + beBuffer)
            strategy.close("TrendLong", comment="MFEProtect TrendLong")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
        if trendShortCanProtect and nz(trendMfeAbs, 0.0) >= level0MfeProtectTrigger and close >= trendEntryPx * (1.0 - beBuffer)
            strategy.close("TrendShort", comment="MFEProtect TrendShort")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            trendEntryPx := na
            trendEntryBar := na
            trendMfeAbs := na
            trendDir := 0
        if revLongCanProtect and not na(reverseEntryPx) and nz(reverseMfeAbs, 0.0) >= level0MfeProtectTrigger and close <= reverseEntryPx * (1.0 + beBuffer)
            strategy.close("RevLong", comment="MFEProtect RevLong")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            reverseEntryPx := na
            reverseEntryBar := na
            reverseMfeAbs := na
            reverseDir := 0
        if revShortCanProtect and not na(reverseEntryPx) and nz(reverseMfeAbs, 0.0) >= level0MfeProtectTrigger and close >= reverseEntryPx * (1.0 - beBuffer)
            strategy.close("RevShort", comment="MFEProtect RevShort")
            trendMode := 0
            breakoutInsideBars := 0
            breakoutEntryBar := na
            reverseStopPx := na
            reverseTpPx := na
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
            reverseEntryPx := na
            reverseEntryBar := na
            reverseMfeAbs := na
            reverseDir := 0

    outsideLongStop = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isLong and outsideLongBars >= outsideStopBars
    outsideShortStop = trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and isShort and outsideShortBars >= outsideStopBars

    if outsideLongStop
        strategy.close("Long1", comment="OutsideStop Long1")
        strategy.close("Long2", comment="OutsideStop Long2")
        strategy.close("Long3", comment="OutsideStop Long3")
        outsideLongBars := 0
        outsideShortBars := 0
        entryPx1 := na
        entryPx2 := na
        entryPx3 := na
        be1 := false
        be2 := false
        be3 := false
        mfe1 := na
        mfe2 := na
        mfe3 := na
        lastEntryBar := bar_index
        didFastExit := true

    if outsideShortStop
        strategy.close("Short1", comment="OutsideStop Short1")
        strategy.close("Short2", comment="OutsideStop Short2")
        strategy.close("Short3", comment="OutsideStop Short3")
        outsideLongBars := 0
        outsideShortBars := 0
        entryPx1 := na
        entryPx2 := na
        entryPx3 := na
        be1 := false
        be2 := false
        be3 := false
        mfe1 := na
        mfe2 := na
        mfe3 := na
        lastEntryBar := bar_index
        didFastExit := true

    if isFlat and not didBreakoutFlip
        if trendMode == 2 or trendMode == -2
            lastBreakoutBar := bar_index
            lastEntryBar := bar_index
        nLong := 0
        nShort := 0
        be1 := false
        be2 := false
        be3 := false
        entryPx1 := na
        entryPx2 := na
        entryPx3 := na
        mfe1 := na
        mfe2 := na
        mfe3 := na
        breakoutInsideBars := 0
        breakoutEntryBar := na
        reverseStopPx := na
        reverseTpPx := na
        outsideLongBars := 0
        outsideShortBars := 0
        trendEntryPx := na
        trendEntryBar := na
        trendMfeAbs := na
        trendDir := 0
        reverseEntryPx := na
        reverseEntryBar := na
        reverseMfeAbs := na
        reverseDir := 0
        trendMode := 0

    nearMidLow = close <= midLow + zoneOffset
    nearSup = close <= smoothSup + zoneOffset
    nearDowner = close <= downerLine + zoneOffset
    nearMidHigh = close >= midHigh - zoneOffset
    nearRes = close >= smoothRes - zoneOffset
    nearUper = close >= uperLine - zoneOffset
    longEntryNearLevel = structureTrend == 1 ? close <= longTrendEntryLevel : nearMidLow
    shortEntryNearLevel = structureTrend == -1 ? close >= shortTrendEntryLevel : nearMidHigh
    long2OvershootOK = close >= smoothSup - maxDeepEntryOvershoot
    long3OvershootOK = close >= downerLine - maxDeepEntryOvershoot
    short2OvershootOK = close <= smoothRes + maxDeepEntryOvershoot
    short3OvershootOK = close <= uperLine + maxDeepEntryOvershoot
    long2ReclaimOK = bullishCandle and close >= smoothSup
    long3ReclaimOK = bullishCandle and close >= downerLine
    short2ReclaimOK = bearishCandle and close <= smoothRes
    short3ReclaimOK = bearishCandle and close <= uperLine
    longMAFilterOK = allowLongByStructure
    shortMAFilterOK = allowShortByStructure
    long1KnifeEntry = close < midLow
    short1KnifeEntry = close > midHigh
    long1AllocPct = l1KnifeHalfSize and long1KnifeEntry ? allocPct1Base * 0.5 : allocPct1Base
    short1AllocPct = l1KnifeHalfSize and short1KnifeEntry ? allocPct1Base * 0.5 : allocPct1Base

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isFlat and cooldownOK and longMAFilterOK and longEntryNearLevel and bullishCandle and rsiVal < rsiLong
        strategy.entry("Long1", strategy.long, qty=strategy.equity * long1AllocPct / 100.0 / close)
        nLong := 1
        nShort := 0
        entryPx1 := close
        entryBar1 := bar_index
        be1 := false
        mfe1 := 0.0
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isLong and nLong == 1 and cooldownOK and allowLongByStructure and nearSup and rsiVal < rsiLong + 10 and (not deepEntryReclaim or (long2OvershootOK and long2ReclaimOK))
        strategy.entry("Long2", strategy.long, qty=strategy.equity * allocPct2Base / 100.0 / close)
        nLong := 2
        entryPx2 := close
        entryBar2 := bar_index
        be2 := false
        mfe2 := 0.0
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isLong and nLong == 2 and cooldownOK and allowLongByStructure and nearDowner and rsiVal < rsiLong + 10 and (not deepEntryReclaim or (long3OvershootOK and long3ReclaimOK))
        strategy.entry("Long3", strategy.long, qty=strategy.equity * allocPct3Base / 100.0 / close)
        nLong := 3
        entryPx3 := close
        entryBar3 := bar_index
        be3 := false
        mfe3 := 0.0
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isFlat and cooldownOK and enableShort and shortMAFilterOK and shortEntryNearLevel and bearishCandle and rsiVal > rsiShort
        strategy.entry("Short1", strategy.short, qty=strategy.equity * short1AllocPct / 100.0 / close)
        nShort := 1
        nLong := 0
        entryPx1 := close
        entryBar1 := bar_index
        be1 := false
        mfe1 := 0.0
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isShort and nShort == 1 and cooldownOK and allowShortByStructure and nearRes and rsiVal > rsiShort - 10 and (not deepEntryReclaim or (short2OvershootOK and short2ReclaimOK))
        strategy.entry("Short2", strategy.short, qty=strategy.equity * allocPct2Base / 100.0 / close)
        nShort := 2
        entryPx2 := close
        entryBar2 := bar_index
        be2 := false
        mfe2 := 0.0
        lastEntryBar := bar_index

    if trendMode == 0 and not didBreakoutFlip and not didBreakoutExit and not didFastExit and isShort and nShort == 2 and cooldownOK and allowShortByStructure and nearUper and rsiVal > rsiShort - 10 and (not deepEntryReclaim or (short3OvershootOK and short3ReclaimOK))
        strategy.entry("Short3", strategy.short, qty=strategy.equity * allocPct3Base / 100.0 / close)
        nShort := 3
        entryPx3 := close
        entryBar3 := bar_index
        be3 := false
        mfe3 := 0.0
        lastEntryBar := bar_index

effStopPlot = isLong ? getStop(nz(entryPx1, strategy.position_avg_price), true, be1) : isShort ? getStop(nz(entryPx1, strategy.position_avg_price), false, be1) : na

pRes = plot(showBands ? smoothRes : na, "Resistance", color=color.new(#FF6347, 0), linewidth=3)
pSup = plot(showBands ? smoothSup : na, "Support", color=color.new(#0084ff, 0), linewidth=3)
plot(showBands ? smoothMid : na, "Midline", color=color.new(color.gray, 30), linewidth=2)
plot(showBands ? midHigh : na, "Mid-High", color=color.new(#daff0b, 50), linewidth=1)
plot(showBands ? midLow : na, "Mid-Low", color=color.new(#0ee9d7, 50), linewidth=1)
pUU = plot(showBands ? uperLine : na, "Upper Ch Edge", color=color.new(#e9940c, 70), linewidth=1)
pDL = plot(showBands ? downerLine : na, "Lower Ch Edge", color=color.new(#099cf1, 70), linewidth=1)
fill(pRes, pUU, color=showBands ? color.new(#e9940c, 88) : na)
fill(pSup, pDL, color=showBands ? color.new(#099cf1, 88) : na)
fill(pSup, pRes, color=showBands ? color.new(color.gray, 95) : na)
plot(showTrendMA ? structureTrendLine : na, "Structure Trendline", color=structureTrendColor, linewidth=3)
plot(showBreakoutBands ? superbuy : na, "Super Buy", color=color.new(color.green, 70), linewidth=1)
plot(showBreakoutBands ? supersell : na, "Super Sell", color=color.new(color.red, 70), linewidth=1)
plot(showStopLine ? effStopPlot : na, "Stop Level", color=color.new(color.fuchsia, 20), style=plot.style_steplinebr, linewidth=2)
