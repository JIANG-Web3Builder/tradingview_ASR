//@version=6
// ASR BTC Indicator - Clean Band Display
// Auto-scales parameters for any timeframe (base = 1h)

indicator("ASR BTC Bands", overlay=true, precision=2)

// ============================================================
// Inputs
// ============================================================
string GRP_TF  = "Timeframe Adaptation"
baseTFMinutes  = input.int(60, "Base Timeframe (min)", group=GRP_TF, tooltip="Parameters optimized on this TF. Auto-scales for others.")

currentTF = timeframe.in_seconds(timeframe.period) / 60.0
tfMultiplier = baseTFMinutes / currentTF

string GRP_IND = "ASR Indicator"
hlLength_input       = input.int(75,   "HL Length (base)",     group=GRP_IND, minval=10, maxval=200)
atrLength_input      = input.int(20,   "ATR Length (base)",    group=GRP_IND, minval=5,  maxval=100)
vovLength_input      = input.int(100,  "VoV Length (base)",    group=GRP_IND, minval=20, maxval=300)
smoothFactor_input   = input.int(12,   "Smooth Factor (base)", group=GRP_IND, minval=2,  maxval=50)
baseWidthPct         = input.float(8.0,"Base Width %",         group=GRP_IND, minval=1.0,maxval=20.0, step=0.5)
adjustFactor         = input.float(0.5,"Adjust Factor",        group=GRP_IND, minval=0.1,maxval=2.0,  step=0.1)
trendMA_input        = input.int(200,  "Trend MA (base)",      group=GRP_IND, minval=50,  maxval=500)

// Scaled values
hlLength     = math.round(math.max(1, hlLength_input * tfMultiplier))
atrLength    = math.round(math.max(1, atrLength_input * tfMultiplier))
vovLength    = math.round(math.max(1, vovLength_input * tfMultiplier))
smoothFactor = math.round(math.max(1, smoothFactor_input * tfMultiplier))
trendMA      = math.round(math.max(1, trendMA_input * tfMultiplier))

string GRP_DSP = "Display"
showTrendMA    = input.bool(true,  "Show Trend MA",       group=GRP_DSP)
showMidBands   = input.bool(true,  "Show Mid-High/Low",   group=GRP_DSP)
showChannelFill= input.bool(true,  "Show Channel Fill",   group=GRP_DSP)

// ============================================================
// ASR Indicator Calculation
// ============================================================
midLine = ta.sma((high + low) / 2.0, hlLength)
atr_val = ta.atr(atrLength)
tr_     = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))

rocVol  = ta.stdev(math.abs(ta.roc(close, 1)), 20) / close * 10000.0
compVol = tr_ * 0.4 + atr_val * 0.4 + rocVol * 0.2
vovDenom = ta.sma(compVol, vovLength)
vov      = vovDenom > 0 ? ta.stdev(compVol, vovLength) / vovDenom : 0.0
vovSafe  = na(vov) or vov > 10.0 ? 0.0 : vov

dynamicOffset = (midLine * baseWidthPct / 100.0 / 2.0) * (1.0 + vovSafe * adjustFactor)

smoothRes  = ta.ema(midLine + dynamicOffset, smoothFactor)
smoothSup  = ta.ema(midLine - dynamicOffset, smoothFactor)
smoothMid  = ta.ema(midLine, smoothFactor)
midHigh    = (smoothMid + smoothRes) / 2.0
midLow     = (smoothMid + smoothSup) / 2.0

// Channel edge bands
upLine      = smoothRes - dynamicOffset * 0.25
uperLine    = smoothRes + dynamicOffset * 0.25
downLine    = smoothSup + dynamicOffset * 0.25
downerLine  = smoothSup - dynamicOffset * 0.25

// Trend MA
ma200 = ta.sma(close, trendMA)

// ============================================================
// Plots
// ============================================================
pRes = plot(smoothRes,  "Resistance", color=color.new(#FF6347, 0), linewidth=3)
pSup = plot(smoothSup,  "Support",   color=color.new(#0084ff, 0), linewidth=3)
plot(smoothMid,          "Midline",   color=color.new(color.gray, 30), linewidth=2)
plot(showMidBands ? midHigh : na, "Mid-High", color=color.new(#daff0b, 40), linewidth=1)
plot(showMidBands ? midLow  : na, "Mid-Low",  color=color.new(#0ee9d7, 40), linewidth=1)

// Channel fill
pUp  = plot(showChannelFill ? upLine     : na, "Upper Ch Top", color=color.new(#e9940c, 60), linewidth=1)
pUU  = plot(showChannelFill ? uperLine   : na, "Upper Ch Bot", color=color.new(#e9940c, 60), linewidth=1)
pDn  = plot(showChannelFill ? downLine   : na, "Lower Ch Top", color=color.new(#099cf1, 60), linewidth=1)
pDL  = plot(showChannelFill ? downerLine : na, "Lower Ch Bot", color=color.new(#099cf1, 60), linewidth=1)
fill(pUp, pUU, color=showChannelFill ? color.new(#e9940c, 85) : na)
fill(pDn, pDL, color=showChannelFill ? color.new(#099cf1, 85) : na)
fill(pSup, pRes, color=color.new(color.gray, 95))

// Trend MA
plot(showTrendMA ? ma200 : na, "Trend MA", color=color.new(color.yellow, 40), linewidth=2)
